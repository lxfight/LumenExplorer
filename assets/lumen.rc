#pragma code_page(65001)
#include <windows.h>

#ifndef LUMEN_VER_MAJOR
#define LUMEN_VER_MAJOR 0
#endif
#ifndef LUMEN_VER_MINOR
#define LUMEN_VER_MINOR 2
#endif
#ifndef LUMEN_VER_PATCH
#define LUMEN_VER_PATCH 1
#endif
#ifndef LUMEN_VER_STR
#define LUMEN_VER_STR 0.2.1.0
#endif

#define _LUMEN_STR(x) #x
#define LUMEN_STR(x) _LUMEN_STR(x)

1 ICON "assets\\lumen.ico"
1 24 "assets\\lumen.manifest"

1 VERSIONINFO
FILEVERSION LUMEN_VER_MAJOR,LUMEN_VER_MINOR,LUMEN_VER_PATCH,0
PRODUCTVERSION LUMEN_VER_MAJOR,LUMEN_VER_MINOR,LUMEN_VER_PATCH,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Lumen"
      VALUE "FileDescription", "Lumen — Modern File Workbench"
      VALUE "FileVersion", LUMEN_STR(LUMEN_VER_STR)
      VALUE "InternalName", "lumen"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "lumen.exe"
      VALUE "ProductName", "Lumen"
      VALUE "ProductVersion", LUMEN_STR(LUMEN_VER_STR)
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
